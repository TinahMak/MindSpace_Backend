# Copy this file to .env and fill in your real values.
# .env is already in .gitignore so it will never be committed.

# Set to True to use local sqlite3 instead of Postgres (quick local testing)
USE_SQLITE=False

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_HOST=db.yourprojectref.supabase.co
DB_PORT=5432

# AI chat — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Weekly insight emails (Celery) — only needed if running the scheduled
# worker/beat processes. Defaults to a local Redis instance.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email — defaults to printing to the console in dev. See README for SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your-resend-api-key
# DEFAULT_FROM_EMAIL=MindSpace <onboarding@resend.dev>

# Google Drive backups (admin panel → Backups). See the update notes.
# The Google account that must receive the backups:
GDRIVE_ACCOUNT_EMAIL=
# Optional (defaults shown):
# GDRIVE_FOLDER_NAME=MindSpace Backups
# GDRIVE_CLIENT_SECRET_FILE=gdrive_client_secret.json
# GDRIVE_TOKEN_FILE=gdrive_token.json
